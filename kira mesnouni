                btn.classList.add('glass-card', 'text-gray-300');
            });
            event.target.classList.add('bg-brand-500', 'text-white');
            event.target.classList.remove('glass-card', 'text-gray-300');

            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Swimming Strokes Data
        const nagesData = {
            crawl: {
                title: "Le Crawl (Nage Libre)",
                badge: "Plus Rapide",
                desc: "Nage ventrale asynchrone caractérisée par une traction continue des bras et un battement ininterrompu des jambes.",
                points: ["Vitesse maximale sous l'eau.", "Respiration latérale rythmée.", "Sollicite intensément le grand dorsal et les triceps."]
            },
            brasse: {
                title: "La Brasse",
                badge: "Plus Technique",
                desc: "Nage symétrique ventrale avec mouvement circulaire simultané des bras et ciseau des jambes.",
                points: ["Nage la plus ancienne historiquement.", "Demande une parfaite coordination motrice.", "Forte sollicitation des adducteurs et des quadriceps."]
            },
            dos: {
                title: "Le Dos Crawlé",
                badge: "Postural & Dorsal",
                desc: "Seule nage effectuée sur le dos. Permet une respiration libre et continue pendant tout le parcours.",
                points: ["Excellente pour corriger la posture de la colonne.", "Ouvre la cage thoracique.", "Recommandée par les kinésithérapeutes."]
            },
            papillon: {
                title: "Le Papillon",
                badge: "Plus Athlétique",
                desc: "Nage spectaculaire basée sur une ondulation simultanée du corps initiée par la tête et le buste.",
                points: ["Dépense calorique la plus élevée.", "Nécessite une grande puissance de la sangle abdominale.", "Exige une grande souplesse épaules/bassin."]
            }
        };

        function switchNage(key) {
            const data = nagesData[key];
            const contentBox = document.getElementById('nage-content');

            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('tab-' + key).classList.add('active');

            contentBox.innerHTML = `
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-xl font-bold text-white">${data.title}</h3>
                    <span class="px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-xs font-bold">${data.badge}</span>
                </div>
                <p class="text-gray-300 text-xs sm:text-sm mb-4 leading-relaxed">${data.desc}</p>
                <div class="space-y-2">
                    ${data.points.map(pt => `<div class="flex items-center gap-2 text-xs text-brand-200"><i class="fa-solid fa-check-circle text-brand-400"></i> ${pt}</div>`).join('')}
                </div>
            `;
        }
        // Initialize default swim tab
        switchNage('crawl');

        // Body Interactive Node Map
        const bodyData = {
            brain: {
                title: "Effets sur le Cerveau & La Santé Mentale",
                icon: "fa-brain",
                color: "text-cyan-400",
                text: "L'exercice physique stimule la sécrétion d'endorphines, de dopamine et de BDNF (Facteur neurotrophique issu du cerveau).",
                bullets: ["Améliore la mémoire et la concentration.", "Diminue les symptômes d'anxiété et de dépression.", "Favorise un sommeil profond et réparateur."]
            },
            heart: {
                title: "Système Cardiovasculaire",
                icon: "fa-heart-pulse",
                color: "text-red-400",
                text: "Le cœur est un muscle. Le sport augmente le volume d'éjection systolique et abaisse le pouls au repos.",
                bullets: ["Réduit le risque de maladies coronariennes de 30%.", "Régule la pression artérielle.", "Améliore la circulation sanguine périphérique."]
            },
            muscles: {
                title: "Muscles, Os & Articulations",
                icon: "fa-dumbbell",
                color: "text-amber-400",
                text: "L'activité physique augmente la masse musculaire et renforce la densité minérale osseuse.",
                bullets: ["Prévient l'ostéoporose et le vieillissement cellulaire.", "Renforce les tendons et ligaments.", "Améliore la posture et l'équilibre."]
            },
            metabolism: {
                title: "Métabolisme & Longévité",
                icon: "fa-fire",
                color: "text-emerald-400",
                text: "Le sport optimise la sensibilité à l'insuline et favorise l'utilisation des graisses comme carburant.",
                bullets: ["Aide au maintien d'un poids de forme sain.", "Réduit les risques de diabète de type 2.", "Augmente l'espérance de vie en bonne santé."]
            }
        };

        function selectBodyPart(key) {
            const data = bodyData[key];
            const panel = document.getElementById('body-info-panel');

            document.querySelectorAll('.body-node').forEach(node => node.classList.remove('active'));
            event.currentTarget.classList.add('active');

            panel.innerHTML = `
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-12 h-12 rounded-xl bg-white/10 ${data.color} flex items-center justify-center text-xl"><i class="fa-solid ${data.icon}"></i></div>
                    <h3 class="text-2xl font-bold">${data.title}</h3>
                </div>
                <p class="text-gray-300 leading-relaxed text-sm mb-4">${data.text}</p>
                <ul class="space-y-2 text-xs text-gray-300">
                    ${data.bullets.map(b => `<li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400"></i> ${b}</li>`).join('')}
                </ul>
            `;
        }

        // Quiz State Logic
        let currentScore = 0;
        let answeredQuestions = 0;

        function checkAnswer(btn, optionIndex) {
            const questionBox = btn.closest('.quiz-q-box');
            if (questionBox.dataset.answered) return;

            questionBox.dataset.answered = "true";
            const correctOption = parseInt(questionBox.dataset.correct);
            const allOpts = questionBox.querySelectorAll('.quiz-opt');

            allOpts.forEach(opt => opt.classList.add('opacity-50', 'cursor-not-allowed'));

            if (optionIndex === correctOption) {
                btn.classList.remove('glass-card', 'opacity-50');
                btn.classList.add('bg-emerald-500/30', 'border-emerald-500', 'text-emerald-200', 'font-bold');
                currentScore++;
                document.getElementById('current-score').innerText = currentScore;
            } else {
                btn.classList.remove('glass-card', 'opacity-50');
                btn.classList.add('bg-red-500/30', 'border-red-500', 'text-red-200');
                
                // Highlight correct one
                allOpts[correctOption - 1].classList.remove('opacity-50');
                allOpts[correctOption - 1].classList.add('bg-emerald-500/20', 'border-emerald-500/50', 'text-emerald-300');
            }

            answeredQuestions++;

            if (answeredQuestions === 4) {
                const resultBox = document.getElementById('quiz-result');
                const resultText = document.getElementById('quiz-final-text');
                resultBox.classList.remove('hidden');

                if (currentScore >= 3) {
                    resultText.innerHTML = `Bravo ! Vous avez obtenu <strong>${currentScore}/4</strong>. Excellente maîtrise du sujet !`;
                    confetti({
                        particleCount: 100,
                        spread: 70,
                        origin: { y: 0.6 }
                    });
                } else {
                    resultText.innerHTML = `Vous avez obtenu <strong>${currentScore}/4</strong>. Rebranchez vos lunettes de natation et relisez l'exposé !`;
                }
            }
        }

        function resetQuiz() {
            currentScore = 0;
            answeredQuestions = 0;
            document.getElementById('current-score').innerText = '0';
            document.getElementById('quiz-result').classList.add('hidden');

            const qBoxes = document.querySelectorAll('.quiz-q-box');
            qBoxes.forEach(box => {
                delete box.dataset.answered;
                const opts = box.querySelectorAll('.quiz-opt');
                opts.forEach(opt => {
                    opt.className = 'quiz-opt p-3 rounded-xl glass-card text-xs font-semibold text-left hover:bg-white/10 transition';
                });
            });
        }
    </script>
</body>
</html>